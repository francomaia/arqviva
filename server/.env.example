# ============================================================
# ArqViva - variáveis do servidor
# Copie para .env e preencha. Nunca versione o .env.
# ============================================================

PORT=3000
# URL pública deste servidor, usada para montar o endereço do webhook.
PUBLIC_URL=https://api.seudominio.com.br
# true serve também a landing page por este processo. Útil só no desenvolvimento.
SERVE_SITE=false

# ---------- Painel ----------
# Usuário e senha do painel de vendas e reembolsos.
PANEL_USER=bethania
PANEL_PASSWORD=troque-esta-senha

# ---------- API da Kiwify ----------
# Apps > API na Kiwify. O token do OAuth vale 96 horas e é renovado sozinho.
KIWIFY_CLIENT_ID=
KIWIFY_CLIENT_SECRET=
KIWIFY_ACCOUNT_ID=
# Opcional: limita o painel a um produto só.
KIWIFY_PRODUCT_ID=
# A API devolve valores em centavos. Troque para false se o painel mostrar cem vezes mais.
KIWIFY_AMOUNT_IN_CENTS=true

# ---------- Webhook ----------
# O mesmo token definido ao criar o webhook na Kiwify.
# A Kiwify assina o corpo com HMAC e manda em ?signature=
KIWIFY_WEBHOOK_TOKEN=
# sha1 é o padrão da Kiwify. Só mude se o painel de logs indicar outro.
KIWIFY_SIGNATURE_ALGO=sha1
# Em true, aceita webhook sem assinatura válida. Use apenas para depurar.
WEBHOOK_ALLOW_UNSIGNED=false

# ---------- WhatsApp ----------
# dryrun = não envia nada, só registra no log. Comece sempre por aqui.
# cloud  = WhatsApp Cloud API da Meta
# zapi   = Z-API
WHATSAPP_PROVIDER=dryrun
# Minutos de espera depois do evento antes de enviar. A Kiwify já demora
# de 10 a 15 minutos para reconhecer o abandono.
WHATSAPP_DELAY_MINUTES=0
# Não manda outra mensagem para o mesmo número dentro desta janela.
WHATSAPP_COOLDOWN_HOURS=72

# Meta WhatsApp Cloud API
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
# Mensagens fora da janela de 24h exigem template aprovado.
WHATSAPP_CLOUD_TEMPLATE=carrinho_abandonado
WHATSAPP_CLOUD_TEMPLATE_LANG=pt_BR

# Z-API
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Texto usado pelo dryrun e pela Z-API. {nome} e {link} são substituídos.
WHATSAPP_MESSAGE=Oi {nome}, aqui é a equipe do ArqViva. Vi que você começou a garantir sua vaga no Arquitetando Processos e não finalizou. Posso te ajudar com alguma dúvida? Se preferir, é só concluir por aqui: {link}
